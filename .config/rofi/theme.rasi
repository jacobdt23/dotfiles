* {
    bg:                         #1a1b26;
    bg-alt:                     #13141c;
    bg-selected:                #24283b;
    fg:                         #c0caf5;
    fg-dim:                     #565f89;
    accent:                     #7aa2f7;
    border-subtle:              #292e42;

    background-color:           transparent;
    text-color:                 var(fg);
    margin:                     0;
    padding:                    0;
}

window {
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      520px;
    height:                     440px;
    enabled:                    true;
    border-radius:              8px;
    border:                     2px;
    border-color:               var(accent);
    background-color:           var(bg);
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    10px;
    padding:                    14px;
    orientation:                vertical;
    children:                   [ "inputbar", "listview" ];
    background-color:           var(bg);
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    9px 12px;
    border-radius:              6px;
    border:                     1px;
    border-color:               var(border-subtle);
    background-color:           var(bg-alt);
    text-color:                 var(fg);
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 var(accent);
    font:                       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 var(fg);
    cursor:                     text;
    placeholder:                "Search...";
    placeholder-color:          var(fg-dim);
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    4px;
    background-color:           var(bg);
}

element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    7px 10px;
    border-radius:              6px;
    background-color:           var(bg);
    text-color:                 var(fg);
    cursor:                     pointer;
    border:                     1px;
    border-color:               transparent;
}

element selected.normal {
    background-color:           var(bg-selected);
    text-color:                 var(accent);
    border-color:               var(accent);
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       24px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}
