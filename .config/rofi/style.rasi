* {
    bg: #1e1e2eE6;
    bg-alt: #313244FF;
    fg: #cdd6f4;
    accent: #89b4fa;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 25%;
    height: 300px;         /* Fixed height to prevent resizing */
    padding: 10px;
    border-radius: 10px;
    background-color: @bg;
}

inputbar {
    padding: 10px;
    border: 0 0 1px 0;    /* Adds a thin line at the bottom of the input */
    border-color: @accent;
    children: [ prompt, entry ];
}

entry {
    placeholder: "Search...";
    padding: 0 0 0 10px;
}

listview {
    padding: 10px 0 0 0;
    lines: 8;             /* Shows exactly 8 items, keeps it compact */
    columns: 1;
    fixed-height: true;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
    spacing: 10px;
}

element selected {
    background-color: @accent;
    text-color: #11111b;
}
