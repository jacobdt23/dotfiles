// Omarchy-esque minimal solid Tokyo Night top bar for Hyprland / Waybar
[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 28,
        "margin-top": 0,
        "margin-left": 0,
        "margin-right": 0,
        "spacing": 0,
        "modules-left": [
            "custom/brand",
            "hyprland/workspaces"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "custom/keys",
            "custom/clipboard",
            "custom/snip",
            "cpu",
            "memory",
            "wireplumber",
            "network",
            "tray",
            "custom/power"
        ],
        "custom/brand": {
            "format": "󰣇",
            "tooltip-format": "Apps (Super + Space)",
            "on-click": "rofi -show drun"
        },
        "hyprland/workspaces": {
            "disable-scroll": false,
            "all-outputs": false,
            "format": "{name}",
            "on-click": "activate",
            "persistent-workspaces": {
                "1": [],
                "2": [],
                "3": [],
                "4": [],
                "5": []
            }
        },
        "clock": {
            "format": "{:%A %H:%M}",
            "format-alt": "{:%a, %b %d  %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "custom/keys": {
            "format": "󰌌",
            "tooltip-format": "Toggle Keybindings (Super + K)",
            "on-click": "/home/jacob/.local/bin/toggle-conky-background"
        },
        "custom/clipboard": {
            "format": "󰅍",
            "tooltip-format": "Clipboard History (Super + Shift + V)",
            "on-click": "/home/jacob/.local/bin/hypr-clipboard"
        },
        "custom/snip": {
            "format": "󰄀",
            "tooltip-format": "Screenshot (Super + Shift + S)",
            "on-click": "/home/jacob/.local/bin/hypr-screenshot",
            "on-click-right": "/home/jacob/.local/bin/hypr-screenshot config"
        },
        "cpu": {
            "interval": 2,
            "format": "󰻠 {usage}%",
            "tooltip": false,
            "on-click": "kitty -e btop"
        },
        "memory": {
            "interval": 2,
            "format": "󰍛 {percentage}%",
            "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
            "on-click": "kitty -e btop"
        },
        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟",
            "format-icons": ["", "", ""],
            "on-click": "pavucontrol"
        },
        "network": {
            "format-ethernet": "󰈀",
            "format-wifi": "󰖩",
            "format-disconnected": "󰈂",
            "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
            "on-click": "nm-connection-editor"
        },
        "tray": {
            "icon-size": 15,
            "spacing": 8
        },
        "custom/power": {
            "format": "⏻",
            "tooltip-format": "Power Menu (Super + Q)",
            "on-click": "sh -c 'choice=$(printf \"󰌾  Lock\\n󰤄  Suspend\\n󰜉  Reboot\\n󰐥  Shutdown\\n󰍃  Log out\" | rofi -dmenu -i -p System); case \"$choice\" in *Lock*) hyprlock;; *Suspend*) systemctl suspend;; *Reboot*) systemctl reboot;; *Shutdown*) systemctl poweroff;; *Log*) hyprctl dispatch exit;; esac'"
        }
    }
]
